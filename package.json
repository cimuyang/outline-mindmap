{
	"name": "outline-mindmap",
	"version": "0.1.0",
	"description": "Obsidian 大纲思维导图插件",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian",
		"mindmap"
	],
	"author": "codex",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "26.1.2",
		"builtin-modules": "5.3.0",
		"esbuild": "0.28.1",
		"obsidian": "1.13.1",
		"tslib": "2.8.1",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"dependencies": {
		"simple-mind-map": "0.14.0-fix.3"
	}
}
